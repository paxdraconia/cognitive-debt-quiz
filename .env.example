# Supabase public keys (safe to ship in the client bundle)
# Client-side only allows INSERT via RLS policy
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-only keys (never exposed to the browser)
# Used by /api/admin-stats to bypass RLS and read aggregates
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=pick-a-strong-password
